{
	"files": [],
	"references": [{ "path": "./tsconfig.app.json" }, { "path": "./tsconfig.node.json" }],
	"extends": "@tsconfig/node23/tsconfig.json",
	"compilerOptions": {
		"outDir": "dist",
		"noImplicitAny": true,
		"removeComments": true,
		"preserveConstEnums": true,
		"sourceMap": true,
		"typeRoots": ["./node_modules/@types"]
	},
	"include": [
		"src/**/*",
		"test/**/*"
	],
	"exclude": ["node_modules"]
}
